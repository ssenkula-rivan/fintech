# ============================================
# GMG Fintech Platform - Git Ignore Rules
# ============================================

# Dependencies
node_modules/
yarn.lock

# Build & compiled outputs
dist/
build/
web-build/
*.js.map
*.tsbuildinfo

# Large binary assets & installers (MUST NOT commit to git)
*.iso
*.dmg
*.tar.gz
*.pkg
mobile/assets/sounds/*.iso

# Environment & Secret configurations
.env
.env.*
!.env.example
*.key
!api/keys/public.key
api/keys/private.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.kiro/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserstate
DerivedData/

# OS-generated files & AppleDouble metadata
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db
ehthumbs.db

# Backups & Database dumps
backups/
*.sql.gz
*.sqlite
*.db

# Process managers & testing
.pm2/
pids/
*.pid
coverage/
.nyc_output/

# Mobile & Expo caches
.expo/
.metro-health-check*
*.jsbundle

# Temporary files
tmp/
temp/
*.tmp

# Windows null device files
nul
**/nul
