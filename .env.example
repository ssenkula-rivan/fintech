# ============================================
# GMG UGANDA - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
DB_NAME=gmg_uganda

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_for_security
JWT_EXPIRY=7d

# Server Configuration
NODE_ENV=development
PORT=3010

# ============================================
# EXCHANGE RATES - Open Exchange Rates API
# Get FREE API key at: https://openexchangerates.org/signup/free
# Free tier: 1000 requests/month, hourly updates
# ============================================
OPENEXCHANGERATES_APP_ID=your_app_id_here

# ============================================
# MTN MOBILE MONEY API (Uganda)
# Get credentials at: https://momodeveloper.mtn.com/
# 1. Create account
# 2. Subscribe to Collection & Disbursement products
# 3. Create API User and get API Key
# ============================================
MTN_MOMO_API_USER=your_api_user_uuid
MTN_MOMO_API_KEY=your_api_key
MTN_MOMO_SUBSCRIPTION_KEY=your_collection_subscription_key
MTN_MOMO_DISBURSEMENT_KEY=your_disbursement_subscription_key
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/webhooks/mtn-callback

# ============================================
# AIRTEL MONEY API (Uganda)
# Get credentials at: https://developers.airtel.africa/
# 1. Create developer account
# 2. Create application
# 3. Get Client ID and Secret
# ============================================
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_MERCHANT_PIN=your_encrypted_merchant_pin
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=https://your-domain.com/api/webhooks/airtel-callback

# ============================================
# AFRICA'S TALKING SMS API
# Get credentials at: https://account.africastalking.com/
# ============================================
AT_API_KEY=your_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=GMG_UG

# ============================================
# WEBHOOK SECRETS (for signature verification)
# Generate secure random strings for production
# ============================================
MTN_WEBHOOK_SECRET=your_mtn_webhook_secret
AIRTEL_WEBHOOK_SECRET=your_airtel_webhook_secret

# ============================================
# GOOGLE OAUTH (Optional - for social login)
# Get credentials at: https://console.cloud.google.com/
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# REDIS CACHE (Optional - for production scaling)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ============================================
# BITY CRYPTO EXCHANGE API
# Get credentials at: https://bity.com/
# Documentation: https://doc.bity.com/exchange/
# Supports: BTC, ETH, USDC ↔ CHF, EUR
# ============================================
BITY_CLIENT_ID=your_client_id
BITY_CLIENT_SECRET=your_client_secret
BITY_ENVIRONMENT=production

# ============================================
# CRYPTO WALLET CONFIGURATION
# CRITICAL: Generate a secure random 32+ character key!
# This encrypts all private keys - if lost, wallets are unrecoverable
# ============================================
WALLET_ENCRYPTION_KEY=your_secure_32_character_encryption_key_here

# Blockchain RPC URLs
# Free public endpoints (rate limited) - use Infura/Alchemy for production
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Block Explorer API Keys (for transaction history)
# Etherscan: https://etherscan.io/apis
# BscScan: https://bscscan.com/apis
# PolygonScan: https://polygonscan.com/apis
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ============================================
# REAL PRICE FEEDS - NO MOCKS
# ============================================

# Open Exchange Rates (Forex) - FREE tier available
# https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=your_app_id_here

# Alpha Vantage (Stocks) - FREE tier: 25 requests/day
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Metals API (Commodities) - Optional
# https://metals-api.com/
METALS_API_KEY=your_api_key_here

# CoinGecko - FREE, no API key required
# Used automatically for crypto prices

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug

# ============================================
# SECURITY - PRODUCTION REQUIRED
# ============================================

# Admin IP Whitelist (comma-separated)
# Only these IPs can access /api/admin routes
ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24

# Metrics API Key (for /metrics endpoint)
METRICS_API_KEY=your_secure_metrics_key_here

# CORS Origins (comma-separated, production only)
CORS_ORIGINS=https://app.gmguganda.com,https://api.gmguganda.com

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_DIR=/var/backups/gmg_uganda
MAX_BACKUPS=7
BACKUP_ENCRYPTION_KEY=your_32_character_encryption_key

# ============================================
# MONITORING & ALERTS
# ============================================
# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Email alerts (optional)
ALERT_EMAIL=admin@gmguganda.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
