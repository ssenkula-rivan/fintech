# GMG Global Mobile App - Environment Variables

# API Configuration
# For iOS Simulator: use localhost
# For Android Emulator: use 10.0.2.2
# For Physical Device: use your computer's IP address
EXPO_PUBLIC_API_URL=http://localhost:3010
EXPO_PUBLIC_API_URL_PROD=https://api.gmguganda.com

# Google OAuth Configuration
EXPO_PUBLIC_WEB_CLIENT_ID=741987457462-78kffpum5ff5vidtjp2kdl1gab9jkr64.apps.googleusercontent.com
EXPO_PUBLIC_ANDROID_CLIENT_ID=your_android_client_id_here
EXPO_PUBLIC_IOS_CLIENT_ID=your_ios_client_id_here

# Apple Sign-In (iOS only)
# Get these from Apple Developer Portal
EXPO_PUBLIC_APPLE_SERVICE_ID=com.gmgglobal.app.signin

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRICS=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_TRADING=true
EXPO_PUBLIC_ENABLE_CRYPTO=true
EXPO_PUBLIC_ENABLE_APPLE_PAY=false

# Debug Configuration
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug

# iOS Specific
# For TestFlight/App Store builds
EXPO_PUBLIC_IOS_BUNDLE_ID=com.gmgglobal.app